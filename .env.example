# Firebase — BẮT BUỘC: FIREBASE_PROJECT_ID = VITE_FIREBASE_PROJECT_ID (cùng một giá trị)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
# Bắt buộc — chỉ UID trong danh sách này mới có thể là admin (phân cách bằng dấu phẩy)
FIREBASE_ADMIN_UIDS=your-firebase-admin-uid

# SePay (Phase 2)
SEPAY_WEBHOOK_SECRET=your-sepay-webhook-secret

# Frontend
VITE_API_URL=http://localhost:5000
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
# Tùy chọn — Firebase Storage (thường cần Blaze/billing). Ảnh SP: /images/products/ hoặc URL ngoài
# VITE_FIREBASE_STORAGE_BUCKET=

# SePay display (checkout page)
VITE_SEPAY_BANK_NAME=Vietcombank
VITE_SEPAY_ACCOUNT_NUMBER=0123456789
VITE_SEPAY_ACCOUNT_NAME=TRANG TRAN HAIR SALON
