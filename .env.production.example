# ── Production environment ──
# Copy to .env before: docker compose -f docker-compose.prod.yml up -d --build

# Backend
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
SEPAY_WEBHOOK_SECRET=your-sepay-webhook-secret
FRONTEND_URL=https://your-domain.com

# Frontend build args (VITE_API_URL empty = nginx proxies /api to backend)
VITE_API_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Tùy chọn — Firebase Storage (thường cần billing). Ảnh SP dùng /images/products/ hoặc URL ngoài.
VITE_FIREBASE_STORAGE_BUCKET=

# SePay bank display (checkout page)
VITE_SEPAY_BANK_NAME=Vietcombank
VITE_SEPAY_ACCOUNT_NUMBER=0123456789
VITE_SEPAY_ACCOUNT_NAME=TRANG TRAN HAIR SALON

# Docker
WEB_PORT=80
