# ── Production: build static assets + serve via nginx ──
FROM node:22-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG VITE_API_URL=
ARG VITE_FIREBASE_API_KEY=
ARG VITE_FIREBASE_AUTH_DOMAIN=
ARG VITE_FIREBASE_PROJECT_ID=
ARG VITE_SEPAY_BANK_NAME=Vietcombank
ARG VITE_SEPAY_ACCOUNT_NUMBER=
ARG VITE_SEPAY_ACCOUNT_NAME=

ENV VITE_API_URL=$VITE_API_URL \
    VITE_FIREBASE_API_KEY=$VITE_FIREBASE_API_KEY \
    VITE_FIREBASE_AUTH_DOMAIN=$VITE_FIREBASE_AUTH_DOMAIN \
    VITE_FIREBASE_PROJECT_ID=$VITE_FIREBASE_PROJECT_ID \
    VITE_SEPAY_BANK_NAME=$VITE_SEPAY_BANK_NAME \
    VITE_SEPAY_ACCOUNT_NUMBER=$VITE_SEPAY_ACCOUNT_NUMBER \
    VITE_SEPAY_ACCOUNT_NAME=$VITE_SEPAY_ACCOUNT_NAME

RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK CMD wget -qO- http://localhost/ || exit 1
